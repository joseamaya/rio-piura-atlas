---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/url";
---

<Base
  title="La cuenca y su salida al mar"
  current="maqueta"
  description="Maqueta 3D del río Piura: la cuenca, el desierto de Sechura y la bahía en un solo bloque. Relieve Copernicus DEM con exageración vertical declarada."
>
  <main id="main" class="wide">
    <div class="map-shell">
      <p id="scene-summary" class="sr-only">
        Maqueta 3D del río Piura con la cuenca, el desierto de Sechura y la bahía.
        La cresta oscura marca la divisoria de aguas. El relieve está exagerado siete
        veces para que se lea; no es una escala real. Arrastra para girar, usa la rueda
        para acercar y haz doble clic para reiniciar la vista.
      </p>
      <div id="scene" role="img" aria-label="Maqueta 3D de la cuenca del río Piura" aria-describedby="scene-summary"></div>

      <aside class="map-panel" aria-label="Información de la maqueta">
        <h2>La cuenca y su salida al mar</h2>
        <p class="src">
          La <strong>cresta oscura</strong> es la divisoria de aguas de la ANA. Dentro
          queda la cuenca; fuera, el desierto de Sechura y la bahía.
        </p>
        <p class="src">
          El río muere en la laguna; las <strong>líneas punteadas</strong> son las rutas
          de crecida que solo con El Niño llegan al mar.
        </p>
        <p class="src">
          Relieve exagerado <strong>×7</strong> para que se lea: no es una escala real.
        </p>
        <hr />
        <p class="src"><strong>Arrastra</strong> para girar · <strong>rueda</strong> para acercar · <strong>doble clic</strong> para reiniciar.</p>
        <hr />
        <p class="src">
          Relieve: Copernicus DEM 30 m · Límites: ANA 1:100 000 · Red: HydroSHEDS.
        </p>
      </aside>
    </div>
    <noscript>
      <p style="padding: 20px;">La maqueta necesita JavaScript. El <a href={withBase("/mapa")}>mapa</a> funciona igual.</p>
    </noscript>
  </main>
</Base>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
  import { DRACOLoader } from "three/addons/loaders/DRACOLoader.js";
  import { withBase } from "../lib/url";

  const container = document.getElementById("scene")!;

  const scene = new THREE.Scene();
  scene.background = new THREE.Color("#cdd6d6");

  const camera = new THREE.PerspectiveCamera(38, 1, 100, 3_000_000);
  const renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  // Mismo revelado que el render de origen (Blender usa AgX).
  renderer.toneMapping = THREE.AgXToneMapping;
  renderer.toneMappingExposure = 1.0;
  container.appendChild(renderer.domElement);

  const controls = new OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  controls.dampingFactor = 0.08;
  controls.maxPolarAngle = Math.PI * 0.49;

  // Sol en la misma posición que la escena de Blender (46°, -42°), con relleno frío.
  scene.add(new THREE.HemisphereLight(0xc8d8e2, 0x8a7f63, 0.45));
  const sun = new THREE.DirectionalLight(0xfff4e0, 3.0);
  sun.position.set(-0.48, 0.70, 0.53).multiplyScalar(1000);
  scene.add(sun);

  let model: THREE.Object3D | null = null;
  const panel = document.querySelector(".map-panel") as HTMLElement | null;
  const lastSize = { w: 0, h: 0 };

  function frame(object: THREE.Object3D) {
    object.updateMatrixWorld(true);
    const box = new THREE.Box3().setFromObject(object);

    // Las placas de las etiquetas agrandan la caja: se encuadra el terreno,
    // pero se mantienen las etiquetas dentro del margen.
    const terrain = new THREE.Box3();
    object.traverse((child) => {
      const mesh = child as THREE.Mesh;
      if (!mesh.isMesh || child.name.includes("Etiqueta")) return;
      if (!mesh.geometry.boundingBox) mesh.geometry.computeBoundingBox();
      if (mesh.geometry.boundingBox) {
        terrain.union(mesh.geometry.boundingBox.clone().applyMatrix4(mesh.matrixWorld));
      }
    });
    const terrainBox = terrain.isEmpty() ? box : terrain;
    const center = terrainBox.getCenter(new THREE.Vector3());
    // La placa se proyecta por debajo del centro geométrico al inclinar la
    // cámara; se apunta un poco más abajo para centrar la masa visible.
    const target = center.clone();
    target.y -= (terrainBox.max.y - terrainBox.min.y) * 0.28;

    // Encuadre ajustado a la cámara: proyecto las esquinas del bloque sobre
    // los ejes de la vista en vez de usar una esfera conservadora.
    const dir = new THREE.Vector3(-0.55, 0.62, 0.85).normalize();
    const right = new THREE.Vector3().crossVectors(new THREE.Vector3(0, 1, 0), dir).normalize();
    const up = new THREE.Vector3().crossVectors(dir, right).normalize();
    let halfW = 0;
    let halfH = 0;
    for (let i = 0; i < 8; i++) {
      const corner = new THREE.Vector3(
        i & 1 ? box.max.x : box.min.x,
        i & 2 ? box.max.y : box.min.y,
        i & 4 ? box.max.z : box.min.z,
      ).sub(center);
      halfW = Math.max(halfW, Math.abs(corner.dot(right)));
      halfH = Math.max(halfH, Math.abs(corner.dot(up)));
    }

    const vFov = THREE.MathUtils.degToRad(camera.fov);
    const distH = halfH / Math.tan(vFov / 2);
    const distW = halfW / (Math.tan(vFov / 2) * camera.aspect);
    const dist = Math.max(distH, distW) * 1.08;

    camera.position.copy(target).addScaledVector(dir, dist);
    camera.lookAt(target);
    camera.near = Math.max(dist / 1000, 0.1);
    camera.far = dist * 40;
    camera.updateProjectionMatrix();

    controls.target.copy(target);
    controls.update();
  }

  // La maqueta ocupa solo el área que deja libre el panel, igual que el mapa.
  function layout() {
    const fullW = container.clientWidth;
    const fullH = container.clientHeight;
    if (!fullW || !fullH) return;

    const narrow = fullW <= 720;
    let left = 0;
    let top = 0;
    let w = fullW;
    let h = fullH;
    if (panel) {
      if (narrow) {
        top = Math.min(panel.offsetTop + panel.offsetHeight + 12, fullH * 0.62);
        h = Math.max(fullH - top, fullH * 0.3);
      } else {
        left = panel.offsetLeft + panel.offsetWidth + 12;
        w = Math.max(fullW - left, fullW * 0.4);
      }
    }

    const style = renderer.domElement.style;
    style.position = "absolute";
    style.left = `${left}px`;
    style.top = `${top}px`;
    renderer.setSize(w, h);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();

    const changed = Math.abs(w - lastSize.w) > 1 || Math.abs(h - lastSize.h) > 1;
    lastSize.w = w;
    lastSize.h = h;
    if (model && changed) frame(model);
  }

  let pendingLayout = 0;
  const scheduleLayout = () => {
    cancelAnimationFrame(pendingLayout);
    pendingLayout = requestAnimationFrame(layout);
  };
  const observer = new ResizeObserver(scheduleLayout);
  observer.observe(container);
  if (panel) observer.observe(panel);
  layout();

  // Los rótulos del modelo están orientados a una cámara fija. Se les añade un
  // pivote y se giran solo en horizontal: así miran al visitante sin perder la
  // inclinación que los mantiene por encima del terreno.
  type LabelPivot = { pivot: THREE.Group; base: THREE.Vector3; yaw0: number };
  const labels: LabelPivot[] = [];
  const _v = new THREE.Vector3();
  const _q = new THREE.Quaternion();

  const draco = new DRACOLoader();
  draco.setDecoderPath(withBase("/draco/"));

  const loader = new GLTFLoader();
  loader.setDRACOLoader(draco);
  loader.load(withBase("/models/piura.glb"), (gltf) => {
    model = gltf.scene;
    scene.add(model);
    scene.updateMatrixWorld(true);
    // Se recogen primero y se recolocan después: no se puede mutar el árbol
    // mientras se recorre.
    const found: THREE.Object3D[] = [];
    model.traverse((child) => {
      if (child.name.startsWith("GEO-Etiqueta")) found.push(child);
    });
    const pivots = new Map<string, LabelPivot>();
    for (const child of found) {
      // La placa y el texto de un mismo rótulo comparten posición: un solo pivote.
      const key = child.name.replace(/-(placa|texto)$/, "");
      let entry = pivots.get(key);
      if (!entry) {
        child.getWorldPosition(_v);
        const pivot = new THREE.Group();
        pivot.position.copy(_v);
        scene.add(pivot);
        const n = new THREE.Vector3(0, 0, 1).applyQuaternion(child.getWorldQuaternion(_q));
        entry = { pivot, base: _v.clone(), yaw0: Math.atan2(n.x, n.z) };
        pivots.set(key, entry);
        labels.push(entry);
      }
      entry.pivot.attach(child);
    }
    layout();
    frame(model);
    animate();
  });

  renderer.domElement.addEventListener("dblclick", () => {
    if (model) frame(model);
  });

  function faceCamera() {
    for (const { pivot, base, yaw0 } of labels) {
      const yaw = Math.atan2(camera.position.x - base.x, camera.position.z - base.z);
      pivot.rotation.y = yaw - yaw0;
    }
  }

  function animate() {
    requestAnimationFrame(animate);
    controls.update();
    faceCamera();
    renderer.render(scene, camera);
  }
</script>
