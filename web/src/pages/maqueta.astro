---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/url";
---

<Base
  title="La cuenca y su salida al mar"
  current="maqueta"
  description="Maqueta 3D del río Piura: la cuenca, el desierto de Sechura y la bahía en un solo bloque. Relieve Copernicus DEM con exageración vertical declarada."
>
  <main id="main" class="wide">
    <div class="map-shell">
      <h1 class="sr-only">La cuenca del río Piura y su salida al mar</h1>
      <p id="scene-summary" class="sr-only">
        Maqueta 3D del río Piura con la cuenca, el desierto de Sechura y la bahía.
        La cresta oscura deriva del límite de cuenca de la ANA. El relieve está
        exagerado siete veces para que se lea; no es una escala real. El color indica
        altitud, no vegetación. El río muere en la laguna Ramón, un polígono OSM
        intermitente que puede estar seco; el agua dibujada es narrativa. Las líneas
        punteadas son trazos aproximados de rutas históricas de crecida y no son
        cartografía oficial. Las subcuencas solo aparecen como rótulos; sus límites
        están en el mapa 2D. Arrastra para girar, usa la rueda para acercar y haz doble
        clic para reiniciar la vista. Con el foco en la maqueta, las flechas giran,
        + y − acercan y Home reinicia. El <a href={withBase("/mapa")}>mapa 2D</a> añade
        la mancha oficial de 2017 y las obras esquemáticas, con capas consultables.
      </p>
      <div id="scene" role="application" tabindex="0" aria-label="Maqueta 3D interactiva de la cuenca del río Piura, el desierto de Sechura y la bahía" aria-describedby="scene-summary"></div>
      <p id="scene-status" class="scene-status" role="status" aria-live="polite"></p>

      <aside class="map-panel scene-panel" aria-label="Información de la maqueta" tabindex="0">
        <h2>La cuenca y su salida al mar</h2>
        <button id="reset-scene" class="btn-draw scene-reset" type="button">Reiniciar vista</button>
        <p class="src panel-sources">
          Base: <a href={withBase("/fuentes#copernicus-dem-30")}>Copernicus DEM (malla ~140 m)</a> ·
          Límites: <a href={withBase("/fuentes#ana-subcuencas")}>ANA 1:100 000</a> ·
          Red: <a href={withBase("/fuentes#hydrorivers")}>HydroRIVERS</a> ·
          Agua: <a href={withBase("/fuentes#osm-agua")}>OSM</a> ·
          Lugares: <a href={withBase("/fuentes#osm-lugares")}>OSM</a>.
        </p>
        <p class="src">
          La <strong>cresta oscura</strong> deriva del límite de cuenca de la ANA.
          Al oeste y al sur quedan el desierto de Sechura y la bahía.
        </p>
        <p class="src">
          El río muere en la <strong>laguna Ramón</strong>. Las
          <strong>líneas punteadas</strong> son trazos aproximados de rutas de crecida;
          no son cartografía oficial.
        </p>
        <p class="src">
          <a href={withBase("/mapa")}>Ver el mapa 2D</a> si prefieres capas consultables
          o navegación con teclado. <strong>Arrastra</strong> para girar ·
          <strong>rueda</strong> para acercar · <strong>doble clic</strong> para reiniciar.
        </p>
        <ul class="map-legend" aria-label="Leyenda de la maqueta">
          <li><span class="swatch river"></span> Cauce y red (HydroRIVERS)</li>
          <li><span class="swatch flooded"></span> <a href={withBase("/escenarios")}>Rutas históricas (interpretación)</a></li>
          <li><span class="swatch divide"></span> Límite de cuenca (ANA)</li>
        </ul>
        <details class="src">
          <summary>Fuentes, método y límites</summary>
          <ul>
            <li>El color del terreno es una rampa hipsométrica: indica altitud, no vegetación.</li>
            <li>La red es HydroRIVERS (~500 m), elevada 45 m para que se lea; no es el cauce exacto.</li>
            <li>La laguna Ramón es un polígono OSM intermitente y puede estar seca; el agua del modelo es narrativa. Las superficies están a cota simbólica (+25 m).</li>
            <li>Las rutas punteadas son una interpretación del equipo; no hay una capa oficial publicada. El relato está en <a href={withBase("/escenarios")}>Escenarios</a>.</li>
            <li>Las subcuencas solo están rotuladas; sus límites están en el <a href={withBase("/mapa")}>mapa 2D</a>.</li>
            <li>El rótulo de cota «Naciente ~2 700 m» fue retirado: el DEM en esa posición mide ~1 935 m. «Reserva Nacional Illescas» se conserva solo como referencia de lugar, no como límite oficial.</li>
            <li>Poechos se muestra como punto en el dique; el canal Daniel Escobar es una recta de referencia, no su eje oficial. Los bordes del bloque no son un corte geológico. Están también en el <a href={withBase("/mapa?capa=obras")}>mapa 2D</a>.</li>
            <li>La maqueta no dibuja la inundación de 2017. Esa capa está en el <a href={withBase("/mapa?capa=inundacion")}>mapa 2D</a> y en <a href={withBase("/escenarios")}>Escenarios</a>.</li>
            <li>Lugares: OSM; subcuencas: ANA; cuerpos de agua: OSM. Coordenadas aproximadas. Relieve: Copernicus GLO-30 remuestreado a ~140 m.</li>
          </ul>
        </details>
      </aside>
    </div>
    <noscript>
      <p style="padding: 20px;">La maqueta necesita JavaScript. El <a href={withBase("/mapa")}>mapa</a> funciona igual.</p>
    </noscript>
  </main>
</Base>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
  import { DRACOLoader } from "three/addons/loaders/DRACOLoader.js";
  import { withBase } from "../lib/url";

  const container = document.getElementById("scene")!;

  const scene = new THREE.Scene();
  scene.background = new THREE.Color("#cdd6d6");

  const camera = new THREE.PerspectiveCamera(38, 1, 100, 3_000_000);
  const renderer = (() => {
    try {
      return new THREE.WebGLRenderer({ antialias: true });
    } catch (error) {
      const statusEl = document.getElementById("scene-status");
      if (statusEl) {
        statusEl.hidden = false;
        statusEl.textContent =
          "Este navegador no pudo iniciar WebGL. Usa el mapa 2D para consultar las capas.";
      }
      throw error;
    }
  })();
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  // Mismo revelado que el render de origen (Blender usa AgX).
  renderer.toneMapping = THREE.AgXToneMapping;
  renderer.toneMappingExposure = 1.0;
  container.appendChild(renderer.domElement);

  const controls = new OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  controls.dampingFactor = 0.08;
  controls.maxPolarAngle = Math.PI * 0.49;
  // Flechas y +/- funcionan cuando el contenedor tiene el foco.
  controls.listenToKeyEvents(container);

  // Sol en la misma posición que la escena de Blender (46°, -42°), con relleno frío.
  scene.add(new THREE.HemisphereLight(0xc8d8e2, 0x8a7f63, 0.45));
  const sun = new THREE.DirectionalLight(0xfff4e0, 3.0);
  sun.position.set(-0.48, 0.70, 0.53).multiplyScalar(1000);
  scene.add(sun);

  let model: THREE.Object3D | null = null;
  const panel = document.querySelector(".map-panel") as HTMLElement | null;
  const status = document.getElementById("scene-status");
  if (status) status.textContent = "Cargando maqueta…";
  const lastSize = { w: 0, h: 0 };

  function frame(object: THREE.Object3D) {
    object.updateMatrixWorld(true);
    const box = new THREE.Box3().setFromObject(object);

    // Las placas de las etiquetas agrandan la caja: se encuadra el terreno,
    // pero se mantienen las etiquetas dentro del margen.
    const terrain = new THREE.Box3();
    object.traverse((child) => {
      const mesh = child as THREE.Mesh;
      if (!mesh.isMesh || child.name.includes("Etiqueta")) return;
      if (!mesh.geometry.boundingBox) mesh.geometry.computeBoundingBox();
      if (mesh.geometry.boundingBox) {
        terrain.union(mesh.geometry.boundingBox.clone().applyMatrix4(mesh.matrixWorld));
      }
    });
    const terrainBox = terrain.isEmpty() ? box : terrain;
    const center = terrainBox.getCenter(new THREE.Vector3());
    // La placa se proyecta por debajo del centro geométrico al inclinar la
    // cámara; se apunta un poco más abajo para centrar la masa visible.
    const target = center.clone();
    target.y -= (terrainBox.max.y - terrainBox.min.y) * 0.28;

    // Encuadre ajustado a la cámara: proyecto las esquinas del bloque sobre
    // los ejes de la vista en vez de usar una esfera conservadora.
    const dir = new THREE.Vector3(-0.55, 0.62, 0.85).normalize();
    const right = new THREE.Vector3().crossVectors(new THREE.Vector3(0, 1, 0), dir).normalize();
    const up = new THREE.Vector3().crossVectors(dir, right).normalize();
    let halfW = 0;
    let halfH = 0;
    for (let i = 0; i < 8; i++) {
      const corner = new THREE.Vector3(
        i & 1 ? box.max.x : box.min.x,
        i & 2 ? box.max.y : box.min.y,
        i & 4 ? box.max.z : box.min.z,
      ).sub(center);
      halfW = Math.max(halfW, Math.abs(corner.dot(right)));
      halfH = Math.max(halfH, Math.abs(corner.dot(up)));
    }

    const vFov = THREE.MathUtils.degToRad(camera.fov);
    const distH = halfH / Math.tan(vFov / 2);
    const distW = halfW / (Math.tan(vFov / 2) * camera.aspect);
    const dist = Math.max(distH, distW) * 1.08;

    camera.position.copy(target).addScaledVector(dir, dist);
    camera.lookAt(target);
    camera.near = Math.max(dist / 1000, 0.1);
    camera.far = dist * 40;
    camera.updateProjectionMatrix();

    controls.target.copy(target);
    controls.update();
  }

  // La maqueta ocupa solo el área que deja libre el panel, igual que el mapa.
  function layout() {
    const fullW = container.clientWidth;
    const fullH = container.clientHeight;
    if (!fullW || !fullH) return;

    const narrow = fullW <= 720;
    let left = 0;
    let top = 0;
    let w = fullW;
    let h = fullH;
    if (panel) {
      if (narrow) {
        top = Math.min(panel.offsetTop + panel.offsetHeight + 12, fullH * 0.62);
        h = Math.max(fullH - top, fullH * 0.3);
      } else {
        left = panel.offsetLeft + panel.offsetWidth + 12;
        w = Math.max(fullW - left, fullW * 0.4);
      }
    }

    const style = renderer.domElement.style;
    style.position = "absolute";
    style.left = `${left}px`;
    style.top = `${top}px`;
    renderer.setSize(w, h);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();

    const changed = Math.abs(w - lastSize.w) > 1 || Math.abs(h - lastSize.h) > 1;
    lastSize.w = w;
    lastSize.h = h;
    if (model && changed) frame(model);
  }

  let pendingLayout = 0;
  const scheduleLayout = () => {
    cancelAnimationFrame(pendingLayout);
    pendingLayout = requestAnimationFrame(layout);
  };
  const observer = new ResizeObserver(scheduleLayout);
  observer.observe(container);
  if (panel) observer.observe(panel);
  layout();

  // Los rótulos del modelo están orientados a una cámara fija. Se les añade un
  // pivote y se giran solo en horizontal: así miran al visitante sin perder la
  // inclinación que los mantiene por encima del terreno.
  type LabelPivot = { pivot: THREE.Group; base: THREE.Vector3; yaw0: number };
  const labels: LabelPivot[] = [];
  const _q = new THREE.Quaternion();

  const draco = new DRACOLoader();
  draco.setDecoderPath(withBase("/draco/"));

  const loader = new GLTFLoader();
  loader.setDRACOLoader(draco);
  loader.load(
    withBase("/models/piura.glb"),
    (gltf) => {
      const root = gltf.scene;
      model = root;
      scene.add(root);
      scene.updateMatrixWorld(true);
      // Se recogen primero y se recolocan después: no se puede mutar el árbol
      // mientras se recorre.
      const found: THREE.Object3D[] = [];
      root.traverse((child) => {
        // Rótulo retirado: la cota 2 700 m no coincide con el DEM en esa posición.
        if (child.name.includes("Naciente")) {
          child.visible = false;
          return;
        }
        if (child.name.startsWith("GEO-Etiqueta")) found.push(child);
      });
      const pivots = new Map<string, LabelPivot>();
      for (const child of found) {
        // La placa y el texto de un mismo rótulo comparten posición: un solo pivote.
        const key = child.name.replace(/-(placa|texto)$/, "");
        let entry = pivots.get(key);
        if (!entry) {
          const world = child.getWorldPosition(new THREE.Vector3());
          const pivot = new THREE.Group();
          // El pivote queda dentro del modelo para que el encuadre siga contando
          // las placas. La raíz glTF no trae rotación; si la trajera, este yaw
          // habría que convertirlo al espacio local.
          pivot.position.copy(root.worldToLocal(world.clone()));
          root.add(pivot);
          // En glTF (Y-up) el frontal de la placa es +Y: la geometría está en XZ.
          const n = new THREE.Vector3(0, 1, 0).applyQuaternion(child.getWorldQuaternion(_q));
          entry = { pivot, base: world, yaw0: Math.atan2(n.x, n.z) };
          pivots.set(key, entry);
          labels.push(entry);
        }
        entry.pivot.attach(child);
      }
      layout();
      frame(root);
      if (status) status.hidden = true;
      animate();
    },
    undefined,
    () => {
      if (!status) return;
      status.textContent = "No se pudo cargar la maqueta. ";
      const link = document.createElement("a");
      link.href = withBase("/mapa");
      link.textContent = "Usa el mapa 2D";
      status.append(link);
      status.hidden = false;
    },
  );

  const resetView = () => {
    if (model) frame(model);
  };
  renderer.domElement.addEventListener("dblclick", resetView);
  document.getElementById("reset-scene")?.addEventListener("click", resetView);
  container.addEventListener("keydown", (event) => {
    if (event.key === "Home" || event.key === "0") {
      event.preventDefault();
      resetView();
    }
  });

  function faceCamera() {
    for (const { pivot, base, yaw0 } of labels) {
      const yaw = Math.atan2(camera.position.x - base.x, camera.position.z - base.z);
      pivot.rotation.y = yaw - yaw0;
    }
  }

  function animate() {
    requestAnimationFrame(animate);
    controls.update();
    faceCamera();
    renderer.render(scene, camera);
  }
</script>
