---
import Base from "../layouts/Base.astro";
import fs from "node:fs";
import yaml from "js-yaml";

const file = new URL("../../../data/sources.yml", import.meta.url);
const data = yaml.load(fs.readFileSync(file, "utf8")) as {
  fuentes: Array<{
    id: string;
    titulo: string;
    institucion: string;
    url: string | null;
    fecha: string | null;
    escala: string | null;
    licencia: string;
    estado: string;
    metodo?: string;
    grupo?: string;
    notas?: string;
  }>;
};

const estado = (e: string) =>
  e === "disponible" ? ["ok", "disponible"] : e === "por_solicitar" ? ["pending", "por solicitar"] : ["warn", "por verificar"];

const orden = ["Límites, relieve y red", "Agua", "Inundaciones y riesgo", "Estudios"];
const grupos = orden
  .map((titulo) => ({ titulo, fuentes: data.fuentes.filter((f) => f.grupo === titulo) }))
  .filter((g) => g.fuentes.length > 0);

const resto = data.fuentes.filter((f) => !orden.includes(f.grupo ?? ""));
if (resto.length > 0) grupos.push({ titulo: "Otras fuentes", fuentes: resto });
---

<Base
  title="Fuentes"
  current="fuentes"
  description="Catálogo de fuentes del Atlas del río Piura: institución, escala, licencia y estado de cada dato, con enlaces directos a la fuente original."
>
  <main id="main">
    <p class="eyebrow">Trazabilidad</p>
    <h1>De dónde sale cada dato</h1>
    <p class="lead">
      Toda capa del atlas apunta a una fuente con institución, escala, fecha y licencia.
      Si un dato no está confirmado, figura como pendiente y no se publica.
    </p>

    {grupos.map((g) => (
      <section>
        <h2>{g.titulo}</h2>
        <table>
          <thead>
            <tr><th>Fuente</th><th>Institución</th><th>Escala</th><th>Licencia</th><th>Estado</th></tr>
          </thead>
          <tbody>
            {g.fuentes.map((f) => {
              const [cls, label] = estado(f.estado);
              return (
                <tr id={f.id}>
                  <td>
                    {f.url ? <a href={f.url} target="_blank" rel="noopener">{f.titulo}</a> : f.titulo}
                    <div class="small muted">
                      {f.fecha ?? "sin fecha"} · {f.metodo ?? "método no declarado"}
                    </div>
                    {f.notas && <div class="small muted">{f.notas}</div>}
                  </td>
                  <td>{f.institucion}</td>
                  <td>{f.escala ?? "—"}</td>
                  <td>{f.licencia}</td>
                  <td><span class={`badge ${cls}`}>{label}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>
    ))}

    <div class="note">
      <strong>Las fuentes pendientes no se dibujan.</strong> SENAMHI, PECHP y CENEPRED
      aparecen aquí porque son necesarias, no porque ya tengamos el dato. La solicitud
      formal está descrita en <code>docs/07-solicitudes.md</code>.
    </div>
  </main>
</Base>
