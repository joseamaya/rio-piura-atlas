---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/url";
---

<Base
  title="Mapa de la cuenca"
  current="mapa"
  description="Mapa interactivo de la cuenca del río Piura: relieve, subcuencas, red hídrica, lagunas, inundación de 2017, obras esquemáticas y cortes transversales."
>
  <main id="main" class="wide">
    <div class="map-shell">
      <p id="map-summary" class="sr-only">
        Mapa de la cuenca del río Piura. Puedes activar o desactivar las capas de
        cuenca, subcuencas, red hídrica, lagunas, inundación de 2017, obras
        esquemáticas, cortes transversales y ciudades. La mancha de 2017 es el
        vector oficial de Copernicus EMSR199 y cubre la llanura baja, no toda la
        cuenca. Las obras son referencias esquemáticas (punto del dique y recta del
        canal). Haz clic sobre una capa para
        ver su dato y su fuente. Usa el botón «Dibujar un corte» y marca dos puntos
        para calcular un perfil de elevación. La información de cada capa está
        disponible en la página de fuentes.
      </p>
      <div id="map" role="application" aria-label="Mapa interactivo de la cuenca del río Piura" aria-describedby="map-summary"></div>

      <aside class="map-panel" aria-label="Capas y fuentes">
        <h2>Capas</h2>
        <button id="toggle-panel" class="panel-toggle" type="button" aria-expanded="true" aria-controls="layer-panel">
          Ocultar capas
        </button>
        <div id="layer-panel">
        <label><input type="checkbox" data-layer="cuenca" checked />
          <span class="swatch" style="background:#6b2e26"></span> Cuenca (ANA)</label>
        <label><input type="checkbox" data-layer="subcuencas" checked />
          <span class="swatch" style="background:#8a7f6a"></span> Subcuencas</label>
        <label><input type="checkbox" data-layer="rios" checked />
          <span class="swatch" style="background:#134f7a"></span> Red hídrica</label>
        <label><input type="checkbox" data-layer="agua" checked />
          <span class="swatch" style="background:#2f6f8a"></span> Lagunas y salinas</label>
        <label><input type="checkbox" data-layer="flood" />
          <span class="swatch" style="background:#0069a0"></span> Inundación 2017</label>
        <label><input type="checkbox" data-layer="obras" />
          <span class="swatch" style="background:#8c5a2b"></span> Obras (referencia)</label>
        <label><input type="checkbox" data-layer="cortes" checked />
          <span class="swatch" style="background:#8c4a1e"></span> Cortes transversales</label>
        <label><input type="checkbox" data-layer="lugares" checked />
          <span class="swatch" style="background:#b4552f"></span> Ciudades</label>
        <p class="src" id="layer-status" aria-live="polite"></p>
        <hr />
        <button id="draw-corte" class="btn-draw" type="button" aria-pressed="false">
          Dibujar un corte
        </button>
        <p class="src" id="draw-hint" aria-live="polite" style="margin-top:6px;">
          Haz dos clics sobre el mapa para trazar un corte y ver su perfil.
        </p>
        <p class="src">
          El trazado libre usa el puntero; los cortes de referencia se abren con teclado
          desde «Cortes de referencia».
        </p>
        <details class="cortes-list">
          <summary>Cortes de referencia</summary>
          <div id="cortes-list" role="list"></div>
        </details>
        <hr />
        <p class="src">
          Base: <a href={withBase("/fuentes#copernicus-dem-30")}>Copernicus DEM (malla ~140 m)</a>.
          Límites: <a href={withBase("/fuentes#ana-subcuencas")}>ANA 1:100 000</a>
          + <a href={withBase("/fuentes#bajo-piura-derivado")}>Bajo Piura derivado</a>.
          Red: <a href={withBase("/fuentes#hydrorivers")}>HydroRIVERS v1.0 (HydroSHEDS)</a>.
          Agua: <a href={withBase("/fuentes#osm-agua")}>OpenStreetMap</a>.
          Inundación 2017: <a href={withBase("/fuentes#copernicus-ems-emsr199")}>Copernicus EMSR199</a>.
          Obras: <a href={withBase("/fuentes#obras-esquematicas")}>elaboración propia (referencia)</a>.
          Lugares: <a href={withBase("/fuentes#osm-lugares")}>OpenStreetMap</a>.
        </p>
        </div>
      </aside>

      <div id="ficha" aria-live="polite">
        <h3>Haz clic en el mapa</h3>
        <p class="muted">Cada elemento muestra su dato y su fuente.</p>
        <button id="ficha-cuenca" class="btn-ficha" type="button">
          Ver ficha de la cuenca
        </button>
      </div>

      <section id="corte-panel" hidden aria-live="polite" aria-label="Perfil del corte transversal">
        <div class="corte-head">
          <h3 id="corte-title">Corte transversal</h3>
          <button id="corte-close" type="button" aria-label="Cerrar el perfil">×</button>
        </div>
        <div id="corte-meta" class="src"></div>
        <div id="corte-chart"></div>
        <p class="src" id="corte-note"></p>
      </section>
    </div>
  </main>
</Base>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import { withBase } from "../lib/url";

  const BBOX: [number, number, number, number] = [-81.45, -6.25, -79.30, -4.55];

  const mapShell = document.querySelector(".map-shell") as HTMLElement | null;
  const layerPanel = document.querySelector(".map-panel") as HTMLElement | null;
  const panelToggle = document.getElementById("toggle-panel") as HTMLButtonElement | null;
  const isNarrow = () => (mapShell?.clientWidth ?? window.innerWidth) <= 720;

  // El panel de capas tapa parte del mapa: el encuadre debe usar ese hueco,
  // no un padding simétrico que esconde el oeste de la cuenca. En móvil también
  // se descuenta la ficha inferior, que antes se comía el sur de la cuenca.
  function mapPadding() {
    const fichaEl = document.getElementById("ficha");
    if (isNarrow()) {
      const top = layerPanel ? layerPanel.offsetTop + layerPanel.offsetHeight + 16 : 24;
      const bottom = (fichaEl?.offsetHeight ?? 0) + 32;
      return { top, bottom, left: 24, right: 24 };
    }
    const left = layerPanel ? layerPanel.offsetLeft + layerPanel.offsetWidth + 16 : 24;
    return { top: 24, bottom: 24, left, right: 24 };
  }

  function fitBasin() {
    map.fitBounds(BBOX, { padding: mapPadding(), duration: 0 });
  }

  // En móvil el panel arranca cerrado para que el mapa tenga área útil.
  if (isNarrow()) {
    layerPanel?.classList.add("collapsed");
    if (panelToggle) {
      panelToggle.textContent = "Mostrar capas";
      panelToggle.setAttribute("aria-expanded", "false");
    }
  }

  interface Perfil {
    nombre: string;
    longitud_km: number;
    elev_min_m: number;
    elev_max_m: number;
    dist_km: number[];
    elev_m: number[];
  }

  interface GridMeta {
    bbox: [number, number, number, number];
    width: number;
    height: number;
    dtype: string;
    byte_order: string;
    row_order: string;
    resolution_m_aprox: number;
  }

  const map = new maplibregl.Map({
    container: "map",
    style: {
      version: 8,
      sources: {},
      layers: [{ id: "bg", type: "background", paint: { "background-color": "#cdd6d6" } }],
    },
    bounds: BBOX,
    fitBoundsOptions: { padding: mapPadding() },
    attributionControl: {
      compact: true,
      customAttribution: `<a href="${withBase("/fuentes#copernicus-dem-30")}">Copernicus DEM GLO-30, malla ~140 m © ESA/Airbus</a>`,
    },
    maxZoom: 14,
    minZoom: 6,
  });

  map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");
  map.addControl(new maplibregl.ScaleControl({ unit: "metric" }), "bottom-right");

  // Reencuadra solo cuando cambia el ancho del contenedor (escritorio ↔ móvil).
  // No se observa el alto del panel: al cambiar un texto de estado no debe
  // resetearse el zoom que eligió el visitante.
  let narrowLayout = isNarrow();
  let pendingFit = 0;
  const scheduleFit = () => {
    cancelAnimationFrame(pendingFit);
    pendingFit = requestAnimationFrame(fitBasin);
  };
  const shellObserver = new ResizeObserver(() => {
    const narrow = isNarrow();
    if (narrow !== narrowLayout) {
      narrowLayout = narrow;
      scheduleFit();
    }
  });
  if (mapShell) shellObserver.observe(mapShell);

  function setPanelCollapsed(collapsed: boolean) {
    layerPanel?.classList.toggle("collapsed", collapsed);
    if (panelToggle) {
      panelToggle.textContent = collapsed ? "Mostrar capas" : "Ocultar capas";
      panelToggle.setAttribute("aria-expanded", String(!collapsed));
    }
    scheduleFit();
  }

  panelToggle?.addEventListener("click", () => {
    setPanelCollapsed(!layerPanel?.classList.contains("collapsed"));
  });

  async function fetchJson<T = any>(url: string): Promise<T> {
    const response = await fetch(url);
    if (!response.ok) {
      throw new Error(`${response.status} ${response.statusText}: ${url}`);
    }
    return (await response.json()) as T;
  }

  const ficha = document.getElementById("ficha");
  const show = (html: string) => { if (ficha) ficha.innerHTML = html; };
  const fuenteLabel = (id: string | undefined) =>
    ({
      "ana-subcuencas": "ANA, 1:100 000",
      "bajo-piura-derivado": "Río Piura Atlas, derivado de ANA",
      "hydrorivers": "HydroRIVERS v1.0 (HydroSHEDS)",
      "osm-agua": "OpenStreetMap",
      "osm-lugares": "OpenStreetMap",
      "copernicus-ems-emsr199": "Copernicus EMSR199",
      "obras-esquematicas": "Río Piura Atlas (interpretación)",
    } as Record<string, string>)[id ?? ""] ?? (id || "fuente no declarada");
  const layerStatus = document.getElementById("layer-status");
  let floodLoaded = false;
  let floodLoading: Promise<void> | null = null;

  async function loadFlood(): Promise<void> {
    if (floodLoaded) return;
    if (floodLoading) return floodLoading;
    if (layerStatus) layerStatus.textContent = "Cargando la mancha de 2017…";
    floodLoading = (async () => {
      try {
        const data = await fetchJson(withBase("/data/flood_2017.geojson"));
        const source = map.getSource("flood") as maplibregl.GeoJSONSource | undefined;
        if (!source) throw new Error("sin fuente flood");
        source.setData(data);
        floodLoaded = true;
        const features = (data.features || []) as Array<{ properties?: { area_km2?: number } }>;
        const total = features.reduce((sum, f) => sum + Number(f.properties?.area_km2 || 0), 0);
        if (layerStatus) {
          layerStatus.textContent =
            `Mancha 2017: ${features.length} zonas, ${Math.round(total).toLocaleString("es-PE")} km².`;
        }
      } catch {
        if (layerStatus) {
          layerStatus.textContent = "No se pudo cargar la mancha de 2017. Revisa la conexión.";
        }
        throw new Error("flood");
      } finally {
        floodLoading = null;
      }
    })();
    return floodLoading;
  }

  async function setFlood(on: boolean): Promise<void> {
    if (on) {
      try {
        await loadFlood();
      } catch {
        const input = document.querySelector<HTMLInputElement>('[data-layer="flood"]');
        if (input) input.checked = false;
        on = false;
      }
    }
    for (const id of ["flood-fill", "flood-line"]) {
      if (map.getLayer(id)) {
        map.setLayoutProperty(id, "visibility", on ? "visible" : "none");
      }
    }
  }

  const panel = document.getElementById("corte-panel")!;
  const chart = document.getElementById("corte-chart")!;
  const corteTitle = document.getElementById("corte-title")!;
  const corteMeta = document.getElementById("corte-meta")!;
  const corteNote = document.getElementById("corte-note")!;
  const drawButton = document.getElementById("draw-corte") as HTMLButtonElement;
  const drawHint = document.getElementById("draw-hint")!;
  let lastCorteTrigger: HTMLElement | null = null;

  let perfiles: Record<string, Perfil> = {};
  let grid: { meta: GridMeta; view: DataView } | null = null;
  let drawMode = false;
  let startPoint: maplibregl.LngLat | null = null;
  let startMarker: maplibregl.Marker | null = null;

  function distanceKm(a: maplibregl.LngLat, b: maplibregl.LngLat): number {
    const lat = ((a.lat + b.lat) / 2) * Math.PI / 180;
    const dx = (b.lng - a.lng) * 111.32 * Math.cos(lat);
    const dy = (b.lat - a.lat) * 110.54;
    return Math.hypot(dx, dy);
  }

  function profileSvg(perfil: Perfil): string {
    const w = 340, h = 150, ml = 40, mr = 10, mt = 12, mb = 26;
    const points = perfil.elev_m
      .map((elev, i) => ({ elev, dist: perfil.dist_km[i] }))
      .filter((p) => Number.isFinite(p.elev) && Number.isFinite(p.dist));
    if (points.length < 2) return '<p class="src">No hay datos de elevación para este corte.</p>';

    const values = points.map((p) => p.elev);
    const min = Math.min(...values);
    const max = Math.max(...values);
    const pad = Math.max(1, (max - min) * 0.08);
    const lo = min - pad;
    const hi = max + pad;
    const maxD = points[points.length - 1].dist || 1;
    const x = (d: number) => ml + (d / maxD) * (w - ml - mr);
    const y = (e: number) => mt + (1 - (e - lo) / (hi - lo)) * (h - mt - mb);
    const line = points.map((p) => `${x(p.dist).toFixed(1)},${y(p.elev).toFixed(1)}`).join(" ");
    const area = `M ${x(0).toFixed(1)},${h - mb} L ${line} L ${x(maxD).toFixed(1)},${h - mb} Z`;

    const gridLines = [0, 0.5, 1].map((t) => {
      const gy = mt + t * (h - mt - mb);
      const val = Math.round(hi - t * (hi - lo));
      return `<line x1="${ml}" y1="${gy}" x2="${w - mr}" y2="${gy}" stroke="#d9d2bf" stroke-width="0.7" />
        <text x="${ml - 5}" y="${gy + 3}" text-anchor="end" font-size="9" fill="#4c5866">${val}</text>`;
    }).join("");

    return `<svg viewBox="0 0 ${w} ${h}" role="img" aria-label="Perfil de elevación del corte ${perfil.nombre}">
      ${gridLines}
      <path d="${area}" fill="#8c4a1e" fill-opacity="0.12" />
      <polyline points="${line}" fill="none" stroke="#8c4a1e" stroke-width="2" stroke-linejoin="round" />
      <line x1="${ml}" y1="${h - mb}" x2="${w - mr}" y2="${h - mb}" stroke="#8a7f6a" stroke-width="1" />
      <text x="${ml}" y="${h - 8}" text-anchor="start" font-size="9" fill="#4c5866">0 km</text>
      <text x="${w - mr}" y="${h - 8}" text-anchor="end" font-size="9" fill="#4c5866">${maxD.toFixed(1)} km</text>
      <text x="${w - mr}" y="${mt + 8}" text-anchor="end" font-size="9" fill="#4c5866">m s. n. m.</text>
    </svg>`;
  }

  function showCorte(
    perfil: Perfil,
    opts: { dibujado?: boolean; resolution?: number; trigger?: HTMLElement | null } = {},
  ) {
    lastCorteTrigger = opts.trigger ?? null;
    panel.hidden = false;
    document.body.classList.add("corte-open");
    corteTitle.textContent = perfil.nombre;
    corteMeta.innerHTML =
      `${perfil.longitud_km.toFixed(1)} km · cota <strong>${Math.round(perfil.elev_min_m)}–${Math.round(perfil.elev_max_m)} m</strong> · ` +
      `<a href="${withBase("/fuentes#copernicus-dem-30")}">Copernicus DEM</a>`;
    chart.innerHTML = profileSvg(perfil);

    if (opts.dibujado) {
      const paso = perfil.dist_km.length > 1
        ? Math.round((perfil.longitud_km * 1000) / (perfil.dist_km.length - 1))
        : null;
      const detalle = [
        opts.resolution ? `malla de ${opts.resolution} m` : "",
        paso ? `una muestra cada ${paso} m` : "",
      ].filter(Boolean).join(", ");
      corteNote.textContent =
        "Corte dibujado sobre una malla derivada de un DEM de trabajo de ~140 m" +
        (detalle ? ` (${detalle})` : "") +
        ". Sirve para explicar la forma del valle; no sirve para dimensionar obras.";
    } else {
      corteNote.textContent =
        "Corte de referencia calculado del DEM de trabajo (~140 m, derivado de Copernicus GLO-30). No sirve para dimensionar obras.";
    }
  }

  function closeCorte() {
    panel.hidden = true;
    document.body.classList.remove("corte-open");
    const target = lastCorteTrigger ?? document.querySelector<HTMLElement>("#map canvas");
    lastCorteTrigger = null;
    target?.focus();
  }

  document.getElementById("corte-close")!.addEventListener("click", closeCorte);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !panel.hidden) {
      event.preventDefault();
      closeCorte();
    }
  });

  async function loadGrid() {
    if (grid) return grid;
    const [meta, response] = await Promise.all([
      fetchJson<GridMeta>(withBase("/data/dem_grid.meta.json")),
      fetch(withBase("/data/dem_grid.bin")),
    ]);
    if (!response.ok) {
      throw new Error(`${response.status} ${response.statusText}: dem_grid.bin`);
    }
    grid = { meta, view: new DataView(await response.arrayBuffer()) };
    return grid;
  }

  function sampleGrid(lon: number, lat: number): number {
    if (!grid) return NaN;
    const [west, south, east, north] = grid.meta.bbox;
    const col = ((lon - west) / (east - west)) * (grid.meta.width - 1);
    const row = ((north - lat) / (north - south)) * (grid.meta.height - 1);
    if (col < 0 || row < 0 || col > grid.meta.width - 1 || row > grid.meta.height - 1) return NaN;
    const c0 = Math.floor(col), r0 = Math.floor(row);
    const c1 = Math.min(c0 + 1, grid.meta.width - 1);
    const r1 = Math.min(r0 + 1, grid.meta.height - 1);
    const fc = col - c0, fr = row - r0;
    const value = (r: number, c: number) =>
      grid!.view.getInt16((r * grid!.meta.width + c) * 2, true);
    const top = value(r0, c0) * (1 - fc) + value(r0, c1) * fc;
    const bottom = value(r1, c0) * (1 - fc) + value(r1, c1) * fc;
    return top * (1 - fr) + bottom * fr;
  }

  async function userProfile(a: maplibregl.LngLat, b: maplibregl.LngLat): Promise<Perfil> {
    const loaded = await loadGrid();
    const total = distanceKm(a, b);
    const dist: number[] = [];
    const elev: number[] = [];
    // Una muestra por celda como máximo: no inventar precisión que la malla no tiene.
    const step = Math.max(loaded.meta.resolution_m_aprox, 1);
    const n = Math.max(2, Math.min(400, Math.ceil((total * 1000) / step) + 1));
    for (let i = 0; i < n; i++) {
      const t = i / (n - 1);
      const lon = a.lng + (b.lng - a.lng) * t;
      const lat = a.lat + (b.lat - a.lat) * t;
      dist.push(Number((total * t).toFixed(2)));
      elev.push(Number(sampleGrid(lon, lat).toFixed(1)));
    }
    const clean = elev.filter((v) => Number.isFinite(v));
    return {
      nombre: "Corte dibujado",
      longitud_km: total,
      elev_min_m: clean.length ? Math.min(...clean) : 0,
      elev_max_m: clean.length ? Math.max(...clean) : 0,
      dist_km: dist,
      elev_m: elev,
    };
  }

  function setDrawMode(on: boolean) {
    drawMode = on;
    drawButton.setAttribute("aria-pressed", String(on));
    drawButton.textContent = on ? "Cancelar el corte" : "Dibujar un corte";
    map.getCanvas().style.cursor = on ? "crosshair" : "";
    if (on) {
      drawHint.textContent = "Haz clic en el primer punto del corte.";
    } else {
      drawHint.textContent = "Haz dos clics sobre el mapa para trazar un corte y ver su perfil.";
      if (startMarker) {
        startMarker.remove();
        startMarker = null;
      }
      startPoint = null;
    }
  }

  drawButton.addEventListener("click", () => setDrawMode(!drawMode));

  map.on("load", async () => {
    fitBasin();
    const failed: string[] = [];
    const empty = { type: "FeatureCollection" as const, features: [] as any[] };
    async function optional<T>(url: string, fallback: T): Promise<T> {
      try {
        return await fetchJson<T>(url);
      } catch (error) {
        console.error(error);
        failed.push(url.split("/").pop() || url);
        return fallback;
      }
    }
    const [cuenca, subcuencas, rios, agua, lugares, cortes, perfilesData, obras] = await Promise.all([
      optional<any>(withBase("/data/cuenca.geojson"), empty),
      optional<any>(withBase("/data/subcuencas.geojson"), empty),
      optional<any>(withBase("/data/red_hidrica.geojson"), empty),
      optional<any>(withBase("/data/agua.geojson"), empty),
      optional<any>(withBase("/data/lugares.geojson"), empty),
      optional<any>(withBase("/data/cortes.geojson"), empty),
      optional<any>(withBase("/data/cortes_perfiles.json"), { perfiles: {} }),
      optional<any>(withBase("/data/obras.geojson"), empty),
    ]);
    if (failed.length && layerStatus) {
      layerStatus.textContent = `No se pudieron cargar: ${failed.join(", ")}. El resto del mapa sigue disponible.`;
    }
    perfiles = perfilesData.perfiles || {};

    let reliefBbox: [number, number, number, number] = [-81.45, -6.25, -79.30, -4.55];
    try {
      const info = await fetchJson<any>(withBase("/data/relieve_info.json"));
      // El ETL guarda [oeste, norte, este, sur].
      reliefBbox = [Number(info.bbox[0]), Number(info.bbox[3]), Number(info.bbox[2]), Number(info.bbox[1])];
    } catch {
      // Se conserva el BBOX de la ventana del atlas como respaldo.
    }

    const listaCortes = document.getElementById("cortes-list");
    if (listaCortes) {
      for (const [id, perfil] of Object.entries(perfiles)) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "corte-link";
        button.dataset.corte = id;
        button.textContent = perfil.nombre;
        button.setAttribute("aria-label", `Ver el perfil de elevación del corte ${perfil.nombre}`);
        button.addEventListener("click", () => showCorte(perfil, { trigger: button }));
        listaCortes.appendChild(button);
      }
    }

    const showCuencaFicha = () => {
      const cuencaProps = cuenca?.features?.[0]?.properties || {};
      const area = Number(cuencaProps.area_km2 || 10938.4);
      show(`<h3>Cuenca del río Piura</h3><p>${Math.round(area).toLocaleString("es-PE")} km² medidos</p>
            <p class="muted">ANA publica 11 022 km² en Shape_Area (EPSG:32718). Fuente: <a href="${withBase("/fuentes#ana-subcuencas")}">ANA, 1:100 000</a></p>`);
    };
    document.getElementById("ficha-cuenca")?.addEventListener("click", showCuencaFicha);

    map.addSource("cuenca", {
      type: "geojson",
      data: cuenca,
      attribution: `<a href="${withBase("/fuentes#ana-subcuencas")}">ANA 1:100 000</a>`,
    });
    map.addSource("subcuencas", {
      type: "geojson",
      data: subcuencas,
      attribution: `<a href="${withBase("/fuentes#ana-subcuencas")}">ANA 1:100 000</a> + <a href="${withBase("/fuentes#bajo-piura-derivado")}">Bajo Piura derivado</a>`,
    });
    map.addSource("rios", {
      type: "geojson",
      data: rios,
      attribution: `<a href="${withBase("/fuentes#hydrorivers")}">HydroRIVERS (CC BY 4.0)</a>`,
    });
    map.addSource("agua", {
      type: "geojson",
      data: agua,
      attribution: `<a href="${withBase("/fuentes#osm-agua")}">© OpenStreetMap (ODbL)</a>`,
    });
    map.addSource("flood", {
      type: "geojson",
      data: { type: "FeatureCollection", features: [] },
      attribution: `<a href="${withBase("/fuentes#copernicus-ems-emsr199")}">© European Union, Copernicus EMSR199 (2017)</a>`,
    });
    map.addSource("obras", {
      type: "geojson",
      data: obras,
      attribution: `<a href="${withBase("/fuentes#obras-esquematicas")}">Obras esquemáticas (elaboración propia)</a>`,
    });
    map.addSource("cortes", {
      type: "geojson",
      data: cortes,
      attribution: `<a href="${withBase("/fuentes#copernicus-dem-30")}">Cortes del Copernicus DEM</a>`,
    });

    map.addLayer({
      id: "cuenca-fill",
      type: "fill",
      source: "cuenca",
      paint: { "fill-color": "#e9dfc4", "fill-opacity": 0.05 },
    });
    map.addLayer({
      id: "cuenca-line",
      type: "line",
      source: "cuenca",
      paint: { "line-color": "#6b2e26", "line-width": 2.4, "line-opacity": 0.95 },
    });
    map.addLayer({
      id: "subcuencas-line",
      type: "line",
      source: "subcuencas",
      paint: { "line-color": "#8a7f6a", "line-width": 1, "line-dasharray": [3, 2], "line-opacity": 0.85 },
    });
    map.addLayer({
      id: "agua-fill",
      type: "fill",
      source: "agua",
      paint: { "fill-color": "#2f6f8a", "fill-opacity": 0.9 },
    });
    map.addLayer({
      id: "flood-fill",
      type: "fill",
      source: "flood",
      layout: { visibility: "none" },
      paint: { "fill-color": "#0069a0", "fill-opacity": 0.45 },
    });
    map.addLayer({
      id: "flood-line",
      type: "line",
      source: "flood",
      layout: { visibility: "none" },
      paint: { "line-color": "#004b72", "line-width": 0.8, "line-opacity": 0.85 },
    });
    map.addLayer({
      id: "rios-line",
      type: "line",
      source: "rios",
      paint: {
        "line-color": "#134f7a",
        "line-opacity": 0.9,
        "line-width": [
          "interpolate", ["linear"], ["get", "aporte_km2"],
          150, 0.8, 800, 1.6, 3000, 2.8, 9000, 4.5,
        ],
      },
    });
    map.addLayer({
      id: "obras-fill",
      type: "fill",
      source: "obras",
      filter: ["==", ["geometry-type"], "Polygon"],
      layout: { visibility: "none" },
      paint: { "fill-color": "#8c5a2b", "fill-opacity": 0.28 },
    });
    map.addLayer({
      id: "obras-line",
      type: "line",
      source: "obras",
      layout: { visibility: "none" },
      paint: {
        "line-color": "#6b3f18",
        "line-width": 2.2,
        "line-dasharray": [2, 2],
        "line-opacity": 0.95,
      },
    });
    map.addLayer({
      id: "obras-point",
      type: "circle",
      source: "obras",
      filter: ["==", ["geometry-type"], "Point"],
      layout: { visibility: "none" },
      paint: {
        "circle-radius": 6,
        "circle-color": "#8c5a2b",
        "circle-stroke-color": "#fffdf7",
        "circle-stroke-width": 2,
      },
    });
    map.addLayer({
      id: "cortes-line",
      type: "line",
      source: "cortes",
      paint: {
        "line-color": "#8c4a1e",
        "line-width": 2,
        "line-dasharray": [2, 2],
        "line-opacity": 0.9,
      },
    });

    // El relieve va debajo de todo: se inserta antes de la primera capa vectorial.
    map.addSource("relieve", {
      type: "image",
      url: withBase("/data/relieve.jpg"),
      coordinates: [
        [reliefBbox[0], reliefBbox[3]],
        [reliefBbox[2], reliefBbox[3]],
        [reliefBbox[2], reliefBbox[1]],
        [reliefBbox[0], reliefBbox[1]],
      ],
    });
    map.addLayer({ id: "relieve", type: "raster", source: "relieve", paint: { "raster-opacity": 1 } });
    map.moveLayer("relieve", "cuenca-fill");

    map.addSource("corte-usuario", {
      type: "geojson",
      data: { type: "FeatureCollection", features: [] },
      attribution: `<a href="${withBase("/fuentes#copernicus-dem-30")}">Corte del Copernicus DEM</a>`,
    });
    map.addLayer({
      id: "corte-usuario-line",
      type: "line",
      source: "corte-usuario",
      paint: { "line-color": "#b4552f", "line-width": 2.4, "line-opacity": 0.95 },
    });

    // Ciudades como marcadores HTML: no requieren glifos ni teselas externas.
    // Piura y Castilla están a ~4 km: se colocan a lados opuestos para que no se
    // tapen entre sí. Cura Mori y La Unión reciben un desplazamiento menor.
    const cityLayout: Record<string, { anchor: "left" | "right"; offset: [number, number] }> = {
      Castilla: { anchor: "right", offset: [-6, -4] },
      Piura: { anchor: "left", offset: [6, -6] },
      "Cura Mori": { anchor: "right", offset: [-6, -6] },
      "La Unión": { anchor: "left", offset: [6, 4] },
      Paita: { anchor: "right", offset: [-6, 0] },
      Chulucanas: { anchor: "right", offset: [-6, 0] },
      Morropón: { anchor: "right", offset: [-6, 0] },
      Salitral: { anchor: "right", offset: [-6, 0] },
      Canchaque: { anchor: "right", offset: [-6, 0] },
      Huarmaca: { anchor: "right", offset: [-6, 0] },
    };
    const markers: maplibregl.Marker[] = [];
    for (const f of lugares.features) {
      const el = document.createElement("div");
      el.className = "city";
      el.dataset.jerarquia = String(f.properties.jerarquia ?? 3);
      el.innerHTML = `<span class="dot"></span>${f.properties.nombre}`;
      const layout = cityLayout[f.properties.nombre] || { anchor: "left" as const, offset: [5, 0] as [number, number] };
      markers.push(
        new maplibregl.Marker({ element: el, anchor: layout.anchor, offset: layout.offset })
          .setLngLat(f.geometry.coordinates)
          .addTo(map),
      );
    }

    // Rótulos de las obras: solo aparecen al activar la capa y si el dato cargó.
    const obraMarkers: maplibregl.Marker[] = [];
    const obrasLugares: Array<[string, [number, number]]> = [
      ["Poechos (punto del dique)", [-80.5036, -4.6686]],
      ["Canal Daniel Escobar (referencia)", [-80.575, -4.855]],
    ];
    if (obras.features?.length) {
      for (const [nombre, coords] of obrasLugares) {
        const el = document.createElement("div");
        el.className = "city obra";
        el.style.display = "none";
        el.innerHTML = `<span class="dot"></span>${nombre}`;
        obraMarkers.push(
          new maplibregl.Marker({ element: el, anchor: "left", offset: [5, 0] })
            .setLngLat(coords)
            .addTo(map),
        );
      }
    }

    map.on("mouseenter", "cortes-line", () => { map.getCanvas().style.cursor = "pointer"; });
    map.on("mouseleave", "cortes-line", () => {
      if (!drawMode) map.getCanvas().style.cursor = "";
    });

    map.on("click", async (e) => {
      if (drawMode) {
        if (!startPoint) {
          startPoint = e.lngLat;
          startMarker = new maplibregl.Marker({ color: "#8c4a1e" }).setLngLat(e.lngLat).addTo(map);
          drawHint.textContent = "Primer punto marcado. Haz clic en el segundo punto.";
          return;
        }

        const a = startPoint;
        const b = e.lngLat;
        if (distanceKm(a, b) < 0.5) {
          drawHint.textContent = "El corte es demasiado corto. Elige un segundo punto más lejano.";
          return;
        }

        const source = map.getSource("corte-usuario") as maplibregl.GeoJSONSource;
        source.setData({
          type: "FeatureCollection",
          features: [{
            type: "Feature",
            geometry: { type: "LineString", coordinates: [[a.lng, a.lat], [b.lng, b.lat]] },
            properties: {},
          }],
        });

        try {
          const perfil = await userProfile(a, b);
          showCorte(perfil, { dibujado: true, resolution: grid?.meta.resolution_m_aprox });
        } catch {
          show('<h3>No se pudo calcular el corte</h3><p class="muted">Revisa que la malla de elevación esté disponible.</p>');
        }
        setDrawMode(false);
        return;
      }

      const hits = map.queryRenderedFeatures(e.point, {
        layers: [
          "subcuencas-line", "agua-fill", "cuenca-line", "cuenca-fill", "rios-line",
          "flood-fill", "obras-fill", "obras-line", "obras-point", "cortes-line",
        ],
      });
      if (!hits.length) {
        show('<h3>Sin elemento</h3><p class="muted">Haz clic sobre una capa.</p>');
        return;
      }

      const corteHit = hits.find((hit) => hit.layer.id === "cortes-line");
      if (corteHit) {
        const id = corteHit.properties?.id as string | undefined;
        const perfil = id ? perfiles[id] : undefined;
        if (perfil) {
          showCorte(perfil);
          return;
        }
      }

      const obraHit = hits.find((hit) => ["obras-fill", "obras-line", "obras-point"].includes(hit.layer.id));
      if (obraHit) {
        const p = obraHit.properties || {};
        show(`<h3>${p.nombre}</h3>
              <p class="muted">${p.nota || "Geometría esquemática; no es un levantamiento."}</p>
              <p class="muted">Fuente: <a href="${withBase("/fuentes#obras-esquematicas")}">elaboración propia (interpretación)</a>.</p>`);
        return;
      }

      const floodHit = hits.find((hit) => hit.layer.id === "flood-fill");
      if (floodHit) {
        const p = floodHit.properties || {};
        const area = Number(p.area_km2 || 0);
        const areaTexto = area.toLocaleString("es-PE", {
          minimumFractionDigits: 1,
          maximumFractionDigits: 1,
        });
        const unionOriginal = Number(p.area_union_original_km2 || 0);
        const overlap = Number(p.solapamiento_observaciones_km2 || 0);
        const observations = Array.isArray(p.observaciones) ? p.observaciones : [];
        const obsHtml = observations.length
          ? observations
              .map(
                (o: any) =>
                  `${o.fecha} · ${o.sensor}: ${Number(o.area_original_km2).toLocaleString("es-PE")} km²`,
              )
              .join("<br>")
          : `${p.fecha_texto || p.fecha}: ${p.sensores || "sensor no declarado"}`;
        show(`<h3>Inundación de marzo de 2017</h3>
              <p><strong>${p.zona}</strong> · ${areaTexto} km² publicados (unión simplificada)</p>
              <p class="muted">${obsHtml}</p>
              <p class="muted">Unión original: ${unionOriginal.toLocaleString("es-PE", { minimumFractionDigits: 3, maximumFractionDigits: 3 })} km² · solapamiento entre fechas: ${overlap.toLocaleString("es-PE", { minimumFractionDigits: 3, maximumFractionDigits: 3 })} km².</p>
              <p class="muted">${p.cobertura || ""}</p>
              <p class="muted">${p.advertencia || ""}</p>
              <p class="muted">Fuente: <a href="${withBase("/fuentes#copernicus-ems-emsr199")}">Copernicus EMSR199</a>. Solo clase <code>Flooded Area</code>; no es un modelo hidráulico ni una mancha simultánea.</p>`);
        return;
      }

      const p = hits[0].properties || {};
      if (p.nombre === "Cuenca del río Piura") {
        showCuencaFicha();
      } else if (p.nombre && p.area_km2) {
        show(`<h3>${p.nombre}</h3><p>Área: <strong>${Math.round(p.area_km2).toLocaleString("es-PE")} km²</strong></p>
              <p class="muted">Fuente: <a href="${withBase("/fuentes")}#${p.fuente}">${fuenteLabel(p.fuente)}</a></p>`);
      } else if (p.aporte_km2) {
        show(`<h3>Tramo de río</h3><p>Área aportante: <strong>${Math.round(p.aporte_km2).toLocaleString("es-PE")} km²</strong></p>
              <p class="muted">Fuente: <a href="${withBase("/fuentes#hydrorivers")}">HydroRIVERS v1.0 (HydroSHEDS)</a></p>`);
      } else if (p.nombre) {
        show(`<h3>${p.nombre}</h3><p class="muted">Fuente: <a href="${withBase("/fuentes")}#${p.fuente}">${fuenteLabel(p.fuente)}</a></p>`);
      } else {
        const cuencaProps = cuenca?.features?.[0]?.properties || {};
        const area = Number(cuencaProps.area_km2 || 10938.4);
        show(`<h3>Cuenca del río Piura</h3><p>${Math.round(area).toLocaleString("es-PE")} km² medidos</p>
              <p class="muted">ANA publica 11 022 km² en Shape_Area (EPSG:32718). Fuente: <a href="${withBase("/fuentes#ana-subcuencas")}">ANA, 1:100 000</a></p>`);
      }
    });

    const capa = new URLSearchParams(location.search).get("capa");
    if (capa === "inundacion" || capa === "flood") {
      const input = document.querySelector<HTMLInputElement>('[data-layer="flood"]');
      if (input) {
        input.checked = true;
        void setFlood(true);
        map.fitBounds([[-80.95, -6.07], [-80.47, -5.14]], {
          padding: mapPadding(),
          duration: 0,
        });
      }
    } else if (capa === "obras") {
      const input = document.querySelector<HTMLInputElement>('[data-layer="obras"]');
      if (input) {
        input.checked = true;
        for (const id of ["obras-fill", "obras-line", "obras-point"]) {
          map.setLayoutProperty(id, "visibility", "visible");
        }
        obraMarkers.forEach((m) => { m.getElement().style.display = ""; });
        map.fitBounds([[-80.70, -5.08], [-80.42, -4.60]], {
          padding: mapPadding(),
          duration: 0,
        });
      }
    }

    document.querySelectorAll<HTMLInputElement>("[data-layer]").forEach((input) => {
      input.addEventListener("change", () => {
        const layer = input.dataset.layer!;
        if (layer === "lugares") {
          markers.forEach((m) => { m.getElement().style.display = input.checked ? "" : "none"; });
          return;
        }
        if (layer === "flood") {
          if (!input.checked && layerStatus) layerStatus.textContent = "";
          void setFlood(input.checked);
          return;
        }
        if (layer === "obras") {
          obraMarkers.forEach((m) => {
            m.getElement().style.display = input.checked ? "" : "none";
          });
        }
        const ids =
          layer === "cuenca" ? ["cuenca-fill", "cuenca-line"]
          : layer === "subcuencas" ? ["subcuencas-line"]
          : layer === "rios" ? ["rios-line"]
          : layer === "obras" ? ["obras-fill", "obras-line", "obras-point"]
          : layer === "cortes" ? ["cortes-line"]
          : ["agua-fill"];
        ids.forEach((id) => map.setLayoutProperty(id, "visibility", input.checked ? "visible" : "none"));
      });
    });

    // Señal observable para las pruebas y para cualquier integración: el mapa
    // terminó de cargar datos, registró los manejadores y pintó las capas.
    // No basta con que terminen los fetch: queryRenderedFeatures necesita el
    // primer render de MapLibre.
    const markMapReady = () => {
      document.getElementById("map")?.setAttribute("data-ready", "true");
    };
    map.once("idle", markMapReady);
    map.triggerRepaint();
  });
</script>
