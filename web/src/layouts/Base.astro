---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import "../styles/global.css";
import { withBase } from "../lib/url";
import pkg from "../../package.json";

const version = (pkg as { version?: string }).version ?? "sin versión";

interface Props {
  title: string;
  current?: string;
  description?: string;
  image?: string;
}
const {
  title,
  current,
  description = "Atlas documentado de la cuenca del río Piura: mapa, relieve 3D, cortes transversales y escenarios históricos.",
  image,
} = Astro.props;
const fullTitle = `${title} · Río Piura Atlas`;
const canonical = new URL(
  Astro.url.pathname.startsWith(import.meta.env.BASE_URL)
    ? Astro.url.pathname
    : withBase(Astro.url.pathname),
  Astro.site ?? "https://joseamaya.github.io",
).href;
const ogImage = image
  ? new URL(withBase(image), Astro.site ?? "https://joseamaya.github.io").href
  : undefined;
const nav = [
  { href: "/", label: "Inicio", key: "inicio" },
  { href: "/mapa", label: "Mapa", key: "mapa" },
  { href: "/maqueta", label: "Maqueta 3D", key: "maqueta" },
  { href: "/escenarios", label: "Escenarios", key: "escenarios" },
  { href: "/fuentes", label: "Fuentes", key: "fuentes" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f1e6" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Río Piura Atlas" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_PE" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content="Atlas de la cuenca del río Piura" />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23f5f1e6'/%3E%3Cpath d='M5 23c6-2 6-8 11-10s8 1 11 1' stroke='%231c5b52' stroke-width='2.5' fill='none'/%3E%3Cpath d='M5 27c6-2 6-8 11-10s8 1 11 1' stroke='%23c9a36a' stroke-width='1.5' fill='none'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href={withBase("/")}>Río Piura <span>Atlas</span></a>
        <nav class="main" aria-label="Navegación principal">
          {nav.map((item) => (
            <a href={withBase(item.href)} aria-current={current === item.key ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="header-tools">
          <button class="menu-button" id="menuButton" type="button" aria-expanded="false" aria-controls="mobileMenu">Menú</button>
        </div>
      </div>
    </header>
    <div class="mobile-menu" id="mobileMenu">
      <ul>
        {nav.map((item, index) => (
          <li>
            <a href={withBase(item.href)} aria-current={current === item.key ? "page" : undefined}>
              {item.label} <span>{String(index + 1).padStart(2, "0")}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <slot />

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <div class="footer-brand">Río Piura Atlas</div>
            <p>Atlas documentado de la cuenca del río Piura. Qué es, cómo funciona, dónde se desborda y qué se construyó para contenerlo.</p>
          </div>
          <div>
            <div class="footer-title">Explorar</div>
            <ul>
              <li><a href={withBase("/mapa")}>Mapa de la cuenca</a></li>
              <li><a href={withBase("/maqueta")}>Maqueta 3D</a></li>
              <li><a href={withBase("/escenarios")}>Escenarios</a></li>
              <li><a href={withBase("/fuentes")}>Fuentes</a></li>
            </ul>
          </div>
          <div>
            <div class="footer-title">Rigor</div>
            <ul>
              <li><a href="https://github.com/joseamaya/rio-piura-atlas/blob/main/docs/03-metodologia.md">Metodología</a></li>
              <li><a href="https://github.com/joseamaya/rio-piura-atlas/blob/main/docs/07-solicitudes.md">Solicitudes de datos</a></li>
              <li><a href="https://github.com/joseamaya/rio-piura-atlas/blob/main/docs/06-como-citar.md">Cómo citar</a></li>
              <li><a href="https://github.com/joseamaya/rio-piura-atlas">Repositorio</a></li>
            </ul>
          </div>
          <div>
            <div class="footer-title">Colofón</div>
            <p>Versión {version} · contenido CC BY 4.0 · código MIT. Datos: ANA, Copernicus, HydroSHEDS y OpenStreetMap.</p>
            <p class="footer-warning">No es un sistema de alerta ni un pronóstico.</p>
          </div>
        </div>
        <div class="footer-rule"></div>
        <div class="footer-bottom">
          <span>Río Piura Atlas · Piura, Perú</span>
          <span>Atlas documentado · <a href="https://github.com/joseamaya/rio-piura-atlas/blob/main/docs/03-metodologia.md">método y fuentes</a></span>
        </div>
      </div>
    </footer>

    <script is:inline>
      const header = document.querySelector(".site-header");
      if (header) {
        const sync = () =>
          document.documentElement.style.setProperty("--header-h", `${header.offsetHeight}px`);
        sync();
        new ResizeObserver(sync).observe(header);
      }
      const menuButton = document.getElementById("menuButton");
      const mobileMenu = document.getElementById("mobileMenu");
      const setMenu = (open) => {
        mobileMenu?.classList.toggle("open", open);
        menuButton?.setAttribute("aria-expanded", String(open));
      };
      menuButton?.addEventListener("click", () => setMenu(!mobileMenu.classList.contains("open")));
      mobileMenu?.addEventListener("click", (event) => {
        if (event.target.closest("a")) setMenu(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && mobileMenu?.classList.contains("open")) {
          setMenu(false);
          menuButton?.focus();
        }
      });
    </script>
  </body>
</html>
